{
  "name": "mcp-dynamics",
  "version": "1.0.0",
  "description": "MCP server for Microsoft Dynamics 365 / Dataverse",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "start:http": "node dist/http.js",
    "health-check": "npm run build && node scripts/health-check.mjs",
    "health-check:http": "npm run build && node scripts/health-check-http.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "tui": "node --experimental-strip-types tui/index.ts",
    "tui:tools": "node --experimental-strip-types tui/index.ts --tools",
    "tui:test": "node --experimental-strip-types tui/index.ts --test",
    "tui:typecheck": "tsc -p tui/tsconfig.json"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "SETUP.md"
  ],
  "bin": {
    "mcp-dynamics": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HollyFredD/mcp-dynamics.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "dynamics365",
    "dataverse",
    "crm",
    "forecast",
    "servicenow",
    "claude"
  ],
  "author": "Frederic Farjon (HollyFredD)",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/HollyFredD/mcp-dynamics/issues"
  },
  "homepage": "https://github.com/HollyFredD/mcp-dynamics#readme",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
